# ========================================================
# AMAR BOGURA — ENVIRONMENT CONFIGURATION
# ========================================================

# Supabase Free Tier Configuration (Get these from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Backend / NestJS Configuration
PORT=4000


# Community login sessions: signing secret for the httpOnly session cookie.
# REQUIRED in production (16+ random chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMMUNITY_AUTH_SECRET=

# Supabase SERVICE ROLE key (Dashboard -> Project Settings -> API -> service_role).
# SERVER ONLY: never prefix with NEXT_PUBLIC_, never commit the real value.
# Required after applying supabase/migrations/20261123000000_optimize_schema.sql, because the
# public anon key becomes read-only (Row Level Security); writes and moderation use this key.
SUPABASE_SERVICE_ROLE_KEY=

# Local PostgreSQL for development (put the real value in .env.local, which is git-ignored).
# When set (and NODE_ENV is not production) the app reads/writes this database instead of Supabase.
# Set it up with: npm run db:setup   (rebuild from scratch: npm run db:reset)
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amar_bogura
